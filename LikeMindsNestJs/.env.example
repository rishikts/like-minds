# =============================================================================
# Database (Supabase Postgres — project ref: yghswgwuzpbvoqpmtyau)
#
# IMPORTANT: Do NOT use the "direct" string the dashboard shows by default
# (db.yghswgwuzpbvoqpmtyau.supabase.co). That host is IPv6-only unless you
# buy the IPv4 add-on, so it will silently fail on most laptops/CI/networks.
# Use the POOLER hostnames below — they are IPv4-compatible and free.
#
# Where to find them:
#   Dashboard -> Project Settings -> Database -> "Connection string"
#   Switch the tabs at the top:
#     - "Transaction pooler" (port 6543) -> goes into DATABASE_URL
#     - "Session pooler"     (port 5432) -> goes into DIRECT_URL
#   Both hostnames look like:  aws-0-<region>.pooler.supabase.com
#   The username is:           postgres.yghswgwuzpbvoqpmtyau   (note the dot+ref)
#
# Replace [YOUR-PASSWORD] (DB password you set when creating the project) and
# [REGION] (your project region — visible in the hostname the dashboard shows).
#
# DATABASE_URL -> pooled (PgBouncer transaction mode), used at runtime
# DIRECT_URL   -> session pooler, used by `prisma migrate` & `prisma db pull`
# =============================================================================
DATABASE_URL="postgresql://postgres.yghswgwuzpbvoqpmtyau:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.yghswgwuzpbvoqpmtyau:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# API Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# =============================================================================
# Supabase Auth
# Dashboard -> Project Settings -> API
#   SUPABASE_URL         = "Project URL"
#   SUPABASE_ANON_KEY    = "anon public" key (safe to ship to clients)
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" key (SERVER ONLY — bypasses RLS)
# Dashboard -> Project Settings -> API -> JWT Settings
#   SUPABASE_JWT_SECRET  = "JWT Secret" (used to verify access tokens)
# =============================================================================
SUPABASE_URL=https://yghswgwuzpbvoqpmtyau.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Storage (Supabase Storage — create the bucket from Dashboard -> Storage)
SUPABASE_STORAGE_BUCKET=like-minds-storage
SUPABASE_STORAGE_URL=https://yghswgwuzpbvoqpmtyau.supabase.co/storage/v1

# Redis (for caching/sessions - optional for future)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug

# CORS (add your Mac LAN IP for iOS Simulator/device, e.g. http://192.168.1.10:3000)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# iOS profile sync (before Supabase Auth JWT on device) — must match Secrets.plist SYNC_API_KEY
SYNC_API_KEY=generate_a_long_random_secret_here

# Email (for future notifications)
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@likeminds.app
