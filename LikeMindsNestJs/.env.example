# =============================================================================
# Database (Supabase Postgres — project ref: yghswgwuzpbvoqpmtyau)
# Get these from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Replace [YOUR-PASSWORD] with the DB password you set when creating the project,
# and [REGION] with your project's region (e.g. ap-south-1).
#
# DATABASE_URL  -> pooled (PgBouncer, transaction mode) for runtime queries
# DIRECT_URL    -> direct connection for Prisma migrations & introspection
# =============================================================================
DATABASE_URL="postgresql://postgres.yghswgwuzpbvoqpmtyau:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.yghswgwuzpbvoqpmtyau:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# API Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# =============================================================================
# Supabase Auth
# Dashboard -> Project Settings -> API
#   SUPABASE_URL         = "Project URL"
#   SUPABASE_ANON_KEY    = "anon public" key (safe to ship to clients)
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" key (SERVER ONLY — bypasses RLS)
# Dashboard -> Project Settings -> API -> JWT Settings
#   SUPABASE_JWT_SECRET  = "JWT Secret" (used to verify access tokens)
# =============================================================================
SUPABASE_URL=https://yghswgwuzpbvoqpmtyau.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Storage (Supabase Storage — create the bucket from Dashboard -> Storage)
SUPABASE_STORAGE_BUCKET=like-minds-storage
SUPABASE_STORAGE_URL=https://yghswgwuzpbvoqpmtyau.supabase.co/storage/v1

# Redis (for caching/sessions - optional for future)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug

# CORS (add your Mac LAN IP for iOS Simulator/device, e.g. http://192.168.1.10:3000)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# iOS profile sync (before Supabase Auth JWT on device) — must match Secrets.plist SYNC_API_KEY
SYNC_API_KEY=generate_a_long_random_secret_here

# Email (for future notifications)
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@likeminds.app
