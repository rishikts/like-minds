# Database
DATABASE_URL="postgresql://user:password@localhost:5432/like_minds?schema=public"

# API Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# Supabase Auth
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Storage
SUPABASE_STORAGE_BUCKET=like-minds-storage
SUPABASE_STORAGE_URL=your_storage_url

# Redis (for caching/sessions - optional for future)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug

# CORS (add your Mac LAN IP for iOS Simulator/device, e.g. http://192.168.1.10:3000)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# iOS profile sync (before Supabase Auth JWT on device) — must match Secrets.plist SYNC_API_KEY
SYNC_API_KEY=generate_a_long_random_secret_here

# Email (for future notifications)
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@likeminds.app
